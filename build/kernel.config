# Overrides applied on top of vendor/rocknix/kernel/linux.aarch64.conf.
#
# ROCKNIX links its initramfs into the kernel; we boot a separate dracut
# initramfs generated inside the image instead.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_LOCALVERSION="-rg35xxsp"
# bootc formats the root ext4 with -O verity; ext4 refuses to mount such a
# filesystem read-write unless the kernel supports fs-verity.
CONFIG_FS_VERITY=y
# Panel descriptions and Realtek WiFi/BT firmware are needed before the root
# filesystem is mounted, so build them into the kernel like ROCKNIX does.
# The list is filled in by build/kernel.sh from the files it stages.
CONFIG_EXTRA_FIRMWARE_DIR="external-firmware"
